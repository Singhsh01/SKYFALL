{
  // F5 debugs SKYFALL (Debug build). CodeLLDB is the most reliable debugger on Apple Silicon;
  // the second entry uses the Microsoft C/C++ extension with lldb instead.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug SKYFALL (CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/skyfall",
      "args": ["--windowed"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "SKYFALL: Build (Debug)"
    },
    {
      "name": "Debug SKYFALL (C/C++ lldb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-debug/skyfall",
      "args": ["--windowed"],
      "cwd": "${workspaceFolder}",
      "MIMode": "lldb",
      "preLaunchTask": "SKYFALL: Build (Debug)"
    },
    {
      "name": "Run SKYFALL (Release)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/skyfall",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "SKYFALL: Build (Release)"
    }
  ]
}
